# The four-field entry point the benchmark CLI reads.
#
# STARTING CONFIGURATION. Two single-GPU L40S machines over TCP, with a small
# model. Validate the settings against the router evaluation's pinned software
# and hardware. This file supplies no measured result or calibrated threshold.
#
# Required EVEN WHEN running against an already-standing deployment, because the
# CLI re-renders a plan to drive its harness pod.
#
# base_dir must point at an llm-d-benchmark checkout at tag v0.8.0: the CLI
# resolves the other paths beneath it, and it also resolves workload profile
# names inside <base_dir>/workload/profiles/<harness>/. Replace the two
# placeholders below, or pass base_dir in.

# [REQUIRED]
{% set base_dir = base_dir | default('<path-to-llm-d-benchmark>') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL, but this is the whole point of the file]
scenario_file:
  path: <path-to-this-repo>/scenarios/scenario.yaml
