{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "remote",
        "namespace": "router-tp4"
      },
      "spec": {
        "activeDeadlineSeconds": 7200,
        "automountServiceAccountToken": false,
        "containers": [
          {
            "command": [
              "python3",
              "-u",
              "/probe/tp4-engines.py",
              "--config",
              "/probe/config.json"
            ],
            "env": [
              {
                "name": "ENGINE_ROLE",
                "value": "remote"
              },
              {
                "name": "POD_IP",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "status.podIP"
                  }
                }
              }
            ],
            "image": "docker.io/vllm/vllm-openai:v0.26.0@sha256:770fe65b2c73ee74a5c42165cf3433de4048cc2cd9c57a937ca4e35aba5aa87b",
            "name": "engines",
            "resources": {
              "limits": {
                "cpu": "32",
                "memory": "128Gi",
                "nvidia.com/gpu": "4"
              },
              "requests": {
                "cpu": "16",
                "memory": "64Gi",
                "nvidia.com/gpu": "4"
              }
            },
            "securityContext": {
              "capabilities": {
                "add": [
                  "IPC_LOCK"
                ]
              }
            },
            "volumeMounts": [
              {
                "mountPath": "/probe",
                "name": "code",
                "readOnly": true
              },
              {
                "mountPath": "/results",
                "name": "results"
              },
              {
                "mountPath": "/cache",
                "name": "cache"
              },
              {
                "mountPath": "/dev/shm",
                "name": "shm"
              }
            ]
          },
          {
            "args": [
              "--port=8000",
              "--model-server-port=8200",
              "--kv-connector=nixlv2",
              "--secure-proxy=false",
              "--zap-log-level=4"
            ],
            "image": "ghcr.io/llm-d/llm-d-router-disagg-sidecar:v0.10.0@sha256:1344adff65f96f76fc00c6003a1c63c1e9bb70f3628307f61f748a89a265b260",
            "name": "routing-proxy",
            "resources": {
              "limits": {
                "memory": "1Gi"
              },
              "requests": {
                "cpu": "250m",
                "memory": "256Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "runAsNonRoot": true
            }
          }
        ],
        "nodeSelector": {
          "kubernetes.io/hostname": "computeinstance-u00xp875pmhd5q340t"
        },
        "restartPolicy": "Never",
        "volumes": [
          {
            "configMap": {
              "name": "tp4-code"
            },
            "name": "code"
          },
          {
            "emptyDir": {
              "sizeLimit": "8Gi"
            },
            "name": "results"
          },
          {
            "emptyDir": {
              "sizeLimit": "100Gi"
            },
            "name": "cache"
          },
          {
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "32Gi"
            },
            "name": "shm"
          }
        ]
      }
    }
  ],
  "kind": "List"
}
