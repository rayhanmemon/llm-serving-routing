[
  {
    "role": "prefill",
    "devices": [
      0,
      1,
      2,
      3
    ],
    "http_port": 8100,
    "command": [
      "vllm",
      "serve",
      "Qwen/Qwen3-32B",
      "--revision",
      "9216db5781bf21249d130ec9da846c4624c16137",
      "--tokenizer-revision",
      "9216db5781bf21249d130ec9da846c4624c16137",
      "--port",
      "8100",
      "--tensor-parallel-size",
      "4",
      "--distributed-executor-backend",
      "mp",
      "--dtype",
      "bfloat16",
      "--kv-cache-dtype",
      "auto",
      "--block-size",
      "64",
      "--max-model-len",
      "131072",
      "--max-num-seqs",
      "8",
      "--max-num-batched-tokens",
      "8192",
      "--gpu-memory-utilization",
      "0.85",
      "--enable-chunked-prefill",
      "--no-enable-prefix-caching",
      "--hf-overrides",
      "{\"rope_scaling\": {\"factor\": 4.0, \"original_max_position_embeddings\": 32768, \"rope_type\": \"yarn\"}}",
      "--kv-transfer-config",
      "{\"kv_buffer_device\": \"cuda\", \"kv_connector\": \"NixlConnector\", \"kv_connector_extra_config\": {\"backends\": [\"UCX\"]}, \"kv_load_failure_policy\": \"fail\", \"kv_role\": \"kv_both\"}",
      "--worker-cls",
      "v029_worker_probe.ProbedWorker",
      "--attention-backend",
      "FLASH_ATTN"
    ],
    "env": {
      "VLLM_USE_V2_MODEL_RUNNER": "1",
      "VLLM_KV_CACHE_LAYOUT": "LBHNC",
      "PYTHONPATH": "/probe",
      "CUDA_VISIBLE_DEVICES": "0,1,2,3",
      "HF_HOME": "/cache",
      "VLLM_NIXL_SIDE_CHANNEL_HOST": "10.97.31.228",
      "VLLM_NIXL_SIDE_CHANNEL_PORT": "5600",
      "UCX_PROTO_INFO": "y",
      "UCX_LOG_LEVEL": "info",
      "UCX_LOG_FILE": "/results/default-a/ucx-prefill.%p.log"
    },
    "log_path": "/results/default-a/prefill.log"
  },
